OJ_DATABASE_URL=sqlite+aiosqlite:///./data/oj.db
OJ_SESSION_COOKIE=oj_session
OJ_SESSION_TTL_HOURS=24
OJ_COOKIE_SECURE=false
OJ_EXECUTOR_ENABLED=true
